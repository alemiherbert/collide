<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Host-agnostic engine: geometry, detection, rules, resolution, audit, reporting and incremental monitoring.
    No Revit dependency. net8.0 loads in Revit 2025/2026 (.NET 8) and Revit 2027 (.NET 10).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Collide</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Collide.Core.Tests" />
  </ItemGroup>
</Project>
