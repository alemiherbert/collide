<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Host-agnostic engine: geometry, detection, rules, resolution, audit, reporting and incremental monitoring.
    No Revit dependency. net8.0 loads in Revit 2025/2026 (.NET 8) and Revit 2027 (.NET 10).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Collide</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same structured logger and version as Tekton (merge target). No Microsoft.Extensions packages here:
         Revit 2025 shares one load context across add-ins, so their generation must match the host runtime. -->
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Collide.Core.Tests" />
  </ItemGroup>
</Project>
